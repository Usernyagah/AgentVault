# ─────────────────────────────────────────────────
# AgentVault – Tameion Treasury Agent
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────

# ── Circle API ──────────────────────────────────
CIRCLE_API_KEY=your_circle_api_key_here
CIRCLE_ENTITY_SECRET=your_entity_secret_here
CIRCLE_WALLET_SET_ID=your_wallet_set_id_here
CIRCLE_USDC_TOKEN_ID=your_arc_testnet_usdc_token_id

# ── Circle Wallets ──────────────────────────────
TREASURY_WALLET_ID=your_treasury_wallet_id
OPERATIONS_WALLET_ID=your_operations_wallet_id
RESERVES_WALLET_ID=your_reserves_wallet_id

# ── Arc Network ─────────────────────────────────
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
ARC_TESTNET_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# ── USYC (Yield) ───────────────────────────────
USYC_VAULT_ADDRESS=0x_usyc_erc4626_vault_address
USYC_SHARE_DECIMALS=6
USYC_MIN_IDLE_THRESHOLD=1000

# ── Arc lending pool (Circle arc-defi-lend-borrow pattern) ──
ARC_LENDING_CONTRACT_ADDRESS=0x_deployed_lending_pool_address
LENDING_TOKEN_DECIMALS=6

# ── Gateway ─────────────────────────────────────
GATEWAY_API_BASE_URL=https://gateway-api-testnet.circle.com
GATEWAY_SOURCE_DOMAINS=26,6

# ── Agent Configuration ────────────────────────
AGENT_MODEL=gpt-4o
OPENAI_API_KEY=your_openai_api_key_here
AGENT_MAX_DAILY_SPEND=5000
AGENT_APPROVAL_THRESHOLD=1000
AGENT_AUTO_INVEST_THRESHOLD=500
AGENT_MIN_RESERVE_BALANCE=200
AGENT_MAX_BORROW_AMOUNT=2000
AGENT_MAX_DAILY_BORROW=3000

# ── Database / Audit Log ───────────────────────
DATABASE_URL=file:./data/agentvault.db
AGENTVAULT_LEDGER_PATH=data/decision-ledger.jsonl
AGENTVAULT_SIGNING_KEY_PATH=data/audit-signing-key.pem

# ── Server ──────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0
AGENTVAULT_API_URL=http://localhost:4000
# On Vercel the synthetic demo is on by default. Set 0 to use live Circle data.
# AGENTVAULT_DEMO_MODE=1
ONBOARDING_ADMIN_TOKEN=
AGENTVAULT_ONBOARDING_PATH=data/onboarding.json

# ── Auth (optional) ────────────────────────────
JWT_SECRET=change_me_in_production
