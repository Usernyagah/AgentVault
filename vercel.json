{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "npm install --prefix ../..",
      "buildCommand": "npm run build --prefix ../.. --workspace=@agentvault/shared --workspace=@agentvault/agent-core --workspace=@agentvault/api --workspace=@agentvault/web"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
